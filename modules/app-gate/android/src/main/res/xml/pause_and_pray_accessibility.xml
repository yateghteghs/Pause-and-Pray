<?xml version="1.0" encoding="utf-8"?>
<!--
  Only window-state changes are requested, and canRetrieveWindowContent is
  false, so the service learns the package name of the app that opened and
  nothing else. isAccessibilityTool stays false: this is a digital-wellbeing
  app, not an accessibility tool (Google Play policy).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:accessibilityFlags="flagDefault"
  android:canRetrieveWindowContent="false"
  android:notificationTimeout="250"
  android:description="@string/app_gate_service_description"
  android:isAccessibilityTool="false" />
